
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Función para verificar si el usuario es dueño o colaborador de una sala (adminId)
    function isAuthorizedAdmin(adminId) {
      return isSignedIn() && (
        request.auth.uid == adminId || 
        exists(/databases/$(database)/documents/admins/$(adminId)/collaborators/$(request.auth.uid))
      );
    }

    match /{path=**}/voters/{vDocId} {
        allow read: if true;
        allow create, update: if isSignedIn();
        allow delete: if isAuthorizedAdmin(resource.data.adminId);
    }

    match /admins/{adminId}/polls/{pollId} {
      allow get: if true; 
      allow list: if true;
      allow create, update, delete: if isAuthorizedAdmin(adminId);

      match /votes/{voteId} {
        allow list, get: if isAuthorizedAdmin(adminId);
        allow create: if 
          // 1. La votación debe estar activa
          get(/databases/$(database)/documents/admins/$(adminId)/polls/$(pollId)).data.status == 'active' &&
          // 2. Solo campos permitidos
          request.resource.data.keys().hasOnly(['selectedOptions', 'pollId', 'adminId', 'createdAt']) &&
          // 3. Validación de opciones según tipo de votación
          request.resource.data.selectedOptions is list &&
          (
            (get(/databases/$(database)/documents/admins/$(adminId)/polls/$(pollId)).data.pollType == 'simple' && 
             request.resource.data.selectedOptions.size() == 1) ||
            (get(/databases/$(database)/documents/admins/$(adminId)/polls/$(pollId)).data.pollType == 'multiple' && 
             request.resource.data.selectedOptions.size() >= 1 && 
             request.resource.data.selectedOptions.size() <= get(/databases/$(database)/documents/admins/$(adminId)/polls/$(pollId)).data.maxSelections)
          ) &&
          // 4. Validación de tiempo (Shuffling compatible)
          request.resource.data.createdAt is timestamp &&
          request.resource.data.createdAt >= get(/databases/$(database)/documents/admins/$(adminId)/polls/$(pollId)).data.activatedAt &&
          request.resource.data.createdAt <= request.time + duration.value(30, 's');

        allow update, delete: if isAuthorizedAdmin(adminId);
      }

      match /voters/{vDocId} {
        allow read: if true;
        allow write: if isAuthorizedAdmin(adminId);
      }
    }

    match /admins/{adminId} {
      allow get: if true;
      allow list: if isAuthorizedAdmin(adminId);
      allow create, update, delete: if isAuthorizedAdmin(adminId);

      match /groups/{groupId} {
        allow read, write: if isAuthorizedAdmin(adminId);
      }
      
      match /collaborators/{collabId} {
        allow read, write: if isAuthorizedAdmin(adminId);
      }

      match /lista_completa/{itemId} {
        allow read, write: if isAuthorizedAdmin(adminId);
      }

      match /orden_lista/{ordenId} {
        allow read, write: if isAuthorizedAdmin(adminId);
      }
      
      match /poll_templates/{templateId} {
        allow read, write: if isAuthorizedAdmin(adminId);
      }
    }
    
    match /poll-lookup/{pollId} {
      allow get: if true;
      allow list, create, delete: if isSignedIn();
    }

    match /salas/{salaId} {
      allow get, list: if true;
    }

    match /authorizedAdmins/{docId} {
      allow read: if true;
    }
  }
}
